{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Seattle: Set up Python environment",
      "type": "process",
      "command": "python3",
      "args": ["scripts/setup_dev.py"],
      "windows": {
        "command": "py",
        "args": ["-3.12", "scripts/setup_dev.py"]
      },
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Seattle: Run backend",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"},
      "args": ["-m", "uvicorn", "seattle_agent.api:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Seattle: Run tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"},
      "args": ["-m", "pytest", "-v"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
